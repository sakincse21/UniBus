# UniBus Mobile - Environment Configuration
# Copy this file to .env and update the values for your environment

# Backend API Configuration
# Use the IP address where your backend server is running
# For local development with emulator/device on same network, use your machine's IP
# Example: http://192.168.10.191:5000
API_BASE_URL=http://192.168.10.191:5000/api/v1

# WebSocket Server Configuration  
# Should point to the same backend server
SOCKET_URL=http://192.168.10.191:5000

# Note: These values can also be configured in app.json under expo.extra
# Priority: app.json extra > environment variables > hardcoded defaults
