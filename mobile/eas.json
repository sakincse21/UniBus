{
  "cli": {
    "version": ">= 18.6.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "http://192.168.10.191:5000/api/v1",
        "EXPO_PUBLIC_SOCKET_URL": "http://192.168.10.191:5000"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://operating-durable-washout.ngrok-free.dev/api/v1",
        "EXPO_PUBLIC_SOCKET_URL": "https://operating-durable-washout.ngrok-free.dev"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://uni-bus-eight.vercel.app/api/v1",
        "EXPO_PUBLIC_SOCKET_URL": "https://uni-bus-eight.vercel.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
